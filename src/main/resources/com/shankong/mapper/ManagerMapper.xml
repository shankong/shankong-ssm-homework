<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shankong.mapper.ManagerMapper">
    <select id="findByNameAndPwd" resultType="com.shankong.pojo.Manager">
        select *
            from tb_manager
            where manager_name=#{managerName} and manager_pwd=#{managerPwd} and manager_state != '2'
    </select>
    <!--<select id="findAllManager" resultType="com.shankong.pojo.Manager">
        select *
            from tb_manager
        where manager_state != '2'
    </select>-->

    <select id="findByPage" resultType="com.shankong.pojo.Manager">
        select *
            from tb_manager
        where manager_state != '2'
        order by manager_id asc
        limit #{limit} offset #{offset}
    </select>

    <select id="count" resultType="int">
        select count(*)
            from tb_manager
        where manager_state != '2'
    </select>
    <delete id="deleteById">
        delete from tb_manager
            where manager_id = #{id}
    </delete>
    <update id="softDeleteById">
        update tb_manager set manager_state = '2'
            where manager_id = #{id}
    </update>
    <update id="updateManager">
        update tb_manager
        <set>
            <if test="managerName != null and managerName != ''">
                manager_name = #{managerName},
            </if>
            <if test="managerPwd != null and managerPwd != ''">
                manager_pwd = #{managerPwd},
            </if>
            <if test="managerState != null and managerState != ''">
                manager_state = #{managerState},
            </if>
        </set>
        where manager_id = #{managerId}
    </update>
    <select id="findById" resultType="com.shankong.pojo.Manager">
        select *
            from tb_manager
            where manager_id = #{id}
    </select>
    <insert id="toAddManager">
        insert into tb_manager(manager_name,manager_pwd,manager_state)
        values(#{managerName},#{managerPwd},#{managerState})
    </insert>
</mapper>